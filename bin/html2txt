#!/usr/bin/env python3
"""HTML を標準入力から読み、本文のテキストだけを標準出力に出す。

macOS の `textutil -convert txt -format html -stdin -stdout` の代わり。Mac でもラズパイでも動く (標準ライブラリだけ)。
短信の qualitative.htm や有報の 0102010_honbun_*.htm を読むのに使う。

    unzip -p <zip> <中のパス> | bin/html2txt
"""
import signal
import sys

signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # head などで途中で閉じられても黙って終わる
from html.parser import HTMLParser

BLOCK = {"p", "div", "br", "tr", "li", "h1", "h2", "h3", "h4", "h5", "h6", "table", "section"}
SKIP = {"script", "style", "head"}


class Text(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out, self.skip = [], 0

    def handle_starttag(self, tag, attrs):
        if tag in SKIP:
            self.skip += 1
        elif tag in BLOCK:
            self.out.append("\n")
        elif tag in ("td", "th"):
            self.out.append("\t")

    def handle_endtag(self, tag):
        if tag in SKIP and self.skip:
            self.skip -= 1
        elif tag in BLOCK:
            self.out.append("\n")

    def handle_data(self, data):
        if not self.skip:
            self.out.append(data.replace("\n", " "))


raw = sys.stdin.buffer.read()
for enc in ("utf-8-sig", "cp932", "euc-jp"):
    try:
        html = raw.decode(enc)
        break
    except UnicodeDecodeError:
        continue
else:
    html = raw.decode("utf-8", errors="replace")

p = Text()
p.feed(html)
for line in "".join(p.out).splitlines():
    line = line.strip().replace("　", " ").strip()
    if line:
        print(line)
